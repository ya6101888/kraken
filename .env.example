# =====================================================================
# 🦑 KRAKEN CONTEXT CONFIGURATION MANIFEST (.env.example)
# Версия спецификации: v1.2 (GOLDEN MASTER)
# =====================================================================

# 🖥️ NETWORK PROXY (Squid Tunneling)
PROXY_ENABLED=TRUE
PROXY_HTTP_URL=http://192.168.0.1:3128
PROXY_TELETHON_TYPE=http

# 🦑 KRAKEN CORE ORCHESTRATION
KRAKEN_CRON_INTERVAL_MINUTES=15
KRAKEN_BULK_FETCH_LIMIT=50
KRAKEN_SESSION_PATH=/app/sessions/kraken.session
KRAKEN_SESSION_BACKUP_PATH=/app/sessions/kraken.session.bak
KRAKEN_HEARTBEAT_INTERVAL_SECONDS=300
KRAKEN_GRACEFUL_SHUTDOWN_TIMEOUT=30

# 🧹 HARVESTER TECHNICAL FILTER
HARVESTER_DEDUP_ENABLED=TRUE
HARVESTER_DISK_CACHE_LIMIT=10000
HARVESTER_CACHE_FILE_PATH=/app/logs/processed_hashes.uid
HARVESTER_MIN_MESSAGE_LENGTH=20
HARVESTER_MAX_MESSAGE_LENGTH=4000
HARVESTER_FILTER_OLDER_THAN_HOURS=24
HARVESTER_REGEX_REMOVE_LINKS=TRUE
HARVESTER_REGEX_REMOVE_HTML=TRUE
HARVESTER_REGEX_REMOVE_EMOJI=FALSE

# 🧠 AI FIREWALL EXPERT SYSTEM (v1.2 Schema)
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_KEY_HERE
AI_MODEL_NAME=gpt-4o-mini
AI_TEMPERATURE=0.0
AI_MAX_TOKENS=1000
AI_REQUEST_TIMEOUT_SECONDS=30
AI_RELEVANCE_THRESHOLD=0.7
AI_PROMPTS_DIR=/app/prompts

# 💾 STORAGE GOOGLE SHEETS API
GSHEETS_SPREADSHEET_ID=1ABCxyz_YOUR_SPREADSHEET_ID_HERE
GSHEETS_WORKSHEET_APPROVED=tg_signals_approved
GSHEETS_WORKSHEET_LOG=tg_mining_log
GSHEETS_WORKSHEET_CHANNELS=tg_channels
GSHEETS_SERVICE_ACCOUNT_PATH=/app/secrets/service_account.json
GSHEETS_BUFFER_SIZE=100
GSHEETS_DLQ_PATH=/app/dlq/failed_writes.json

# 📡 TELEGRAM MTPROTO APP INTERFACES
TG_API_ID=1234567
TG_API_HASH=abc123your_api_hash_here
TG_PHONE_NUMBER=71234567890
TG_2FA_PASSWORD=your_password_if_enabled
TG_FLOODWAIT_MAX_WAIT_SECONDS=30

# 🚨 MONITORING SRE BEACON MONITOR
BEACON_ENABLED=TRUE
BEACON_BOT_TOKEN=123456:ABC-your_bot_token_here
BEACON_CHAT_ID=-100your_monitoring_channel_id
BEACON_RATE_LIMIT_PER_ERROR_MINUTES=5
BEACON_HEALTH_CHECK_INTERVAL_SECONDS=30
BEACON_LOCAL_LOG_PATH=/app/logs/alerts.log

# 🏗️ INFRASTRUCTURE LAYER
INFRA_LOG_LEVEL=INFO
INFRA_ENVIRONMENT=production
PYTHONUNBUFFERED=1